<Window x:Class="DualSenseVoice.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DualSense Voice" Width="760" Height="600" MinWidth="640" MinHeight="520"
 Background="#0D1220" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterScreen">
 <Grid Margin="36">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="D U A L S E N S E   V O I C E" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
   <TextBlock Text="話すだけで、入力する。" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,4"/>
   <TextBlock Text="Bluetooth接続のDualSenseマイクから、どのアプリにも文字を貼り付けられます。" Foreground="{StaticResource Muted}" FontSize="14"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#171E2F" CornerRadius="14" Padding="18" Margin="0,24,0,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="入力デバイス" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><ComboBox x:Name="DeviceBox" MinWidth="460" DisplayMemberPath="FriendlyName"/></StackPanel>
    <Button Grid.Column="1" x:Name="RefreshButton" Content="再読込" Background="#2A334A" Margin="12,24,0,0" Click="Refresh_Click"/>
   </Grid>
  </Border>
  <Border Grid.Row="2" Background="#171E2F" CornerRadius="14" Padding="18" Margin="0,0,0,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="認識モデル" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ModelStatus" Text="未確認" FontSize="15" Margin="0,5,0,0"/></StackPanel>
    <Button Grid.Column="1" x:Name="DownloadButton" Content="モデルを準備" Click="Download_Click"/>
   </Grid>
  </Border>
  <Border Grid.Row="3" Background="#171E2F" CornerRadius="14" Padding="18">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><TextBlock x:Name="StatusText" Text="待機中" FontSize="14"/><TextBlock Text="Ctrl + Shift + Space で録音 / 停止" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid>
    <TextBox Grid.Row="1" x:Name="TranscriptBox" Margin="0,14,0,0" Padding="14" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="18" Background="#0F1524" Foreground="{StaticResource Ink}" BorderThickness="0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="4" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <CheckBox x:Name="AutoPasteBox" Content="停止後、元のアプリへ自動貼り付け" IsChecked="True" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
   <Button Grid.Column="1" Content="コピー" Background="#2A334A" Margin="0,0,10,0" Click="Copy_Click"/>
   <Button Grid.Column="2" x:Name="RecordButton" Content="録音を開始" MinWidth="140" Click="Record_Click"/>
  </Grid>
 </Grid>
</Window>

